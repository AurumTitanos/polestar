# Copy to .env next to compose.yaml and fill in. Never commit .env.

# The bot's token: Discord Developer Portal, your application, Bot, Reset Token.
DISCORD_TOKEN=

# The #bugs forum channel's id (Developer Mode on, right-click #bugs, Copy Channel ID).
DISCORD_FORUM_ID=

# Fine-grained GitHub token, repository fitzforge/polestar only, with
# Issues: Read and write, and Contents: Read and write (for the screenshots branch).
GITHUB_TOKEN=

# Where issues go.
GITHUB_REPO=fitzforge/polestar

# Where screenshots go: a branch the bot creates (orphan, never merged).
# MEDIA_REPO and MEDIA_TOKEN default to GITHUB_REPO and GITHUB_TOKEN; set
# them to keep the screenshots (and the Contents permission) in another repo.
MEDIA_BRANCH=bug-media
# MEDIA_REPO=fitzforge/polestar-bug-media
# MEDIA_TOKEN=

# Posts made before this time are never filed (ISO date). Leave empty to file
# every open post the first time the bot starts.
SYNC_SINCE=
